# Public business details
# Set the final HTTPS origin only once the client confirms the domain (no path).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
# Keep previews out of search. Enable only after content approval and launch QA.
SITE_INDEXING_ENABLED=false

# Contact delivery (Phase 3)
CONTACT_DELIVERY_ENABLED=false
# Exact origins, comma separated, no paths or trailing slashes.
CONTACT_ALLOWED_ORIGINS=http://localhost:3000
CONTACT_EMAIL=
# An address on a domain verified in Resend (not the recipient's Outlook address).
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# Cloudflare Turnstile (Phase 3)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared rate limiting (Phase 3): Upstash Redis REST credentials, server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTACT_HASH_SECRET=
